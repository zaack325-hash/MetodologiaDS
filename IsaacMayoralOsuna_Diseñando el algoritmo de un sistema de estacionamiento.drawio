        <mxCell id="0Tio4Mt13xS4k5-K0IEx-45" parent="0Tio4Mt13xS4k5-K0IEx-44" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="&lt;p class=&quot;MsoNormal&quot; style=&quot;text-align: justify;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;span style=&quot;line-height: 107%;&quot;&gt;1. Identificación del Problema&lt;/span&gt;&lt;/b&gt;&lt;/font&gt;&lt;/p&gt;&lt;p class=&quot;MsoNormal&quot;&gt;&lt;/p&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;El objetivo es diseñar la lógica de un sistema automatizado&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;line-height: 107%;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;para el control de acceso vehicular en el estacionamiento de Plaza Galerías, el&lt;/span&gt;&lt;/div&gt;&lt;font style=&quot;&quot;&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;sistema debe validar dos condiciones obligatorias antes de permitir el ingreso.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Que el usuario esté registrado y que existan lugares libres y actualizar en&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;tiempo real la cantidad de espacios disponibles.&lt;/span&gt;&lt;/div&gt;&lt;/font&gt;&lt;/font&gt;&lt;/span&gt;&lt;p&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="150" width="240" y="30" as="geometry" />
        </mxCell>
        <mxCell id="0Tio4Mt13xS4k5-K0IEx-46" parent="0Tio4Mt13xS4k5-K0IEx-44" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="&lt;p class=&quot;MsoNormal&quot;&gt;&lt;b&gt;&lt;span style=&quot;font-size:8.0pt;line-height:107%;font-family:&amp;lt;br/&amp;gt;&amp;quot;Arial&amp;quot;,sans-serif&quot;&gt;2. Identificación de las Entradas&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;ul style=&quot;margin-top:0cm&quot; type=&quot;disc&quot;&gt; &lt;li class=&quot;MsoNormal&quot;&gt;&lt;b&gt;&lt;span style=&quot;font-size:8.0pt;line-height:107%;font-family:&amp;quot;Arial&amp;quot;,sans-serif&quot;&gt;Matrícula:&lt;/span&gt;&lt;/b&gt;&lt;span style=&quot;font-size:8.0pt;line-height:107%;font-family:&amp;quot;Arial&amp;quot;,sans-serif&quot;&gt;&lt;br&gt;     Cadena de texto que identifica el vehículo del conductor.&lt;/span&gt;&lt;/li&gt;&lt;br&gt; &lt;li class=&quot;MsoNormal&quot;&gt;&lt;b&gt;&lt;span style=&quot;font-size:8.0pt;line-height:107%;font-family:&amp;quot;Arial&amp;quot;,sans-serif&quot;&gt;Registrado:&lt;/span&gt;&lt;/b&gt;&lt;span style=&quot;font-size:8.0pt;line-height:107%;font-family:&amp;quot;Arial&amp;quot;,sans-serif&quot;&gt;&lt;br&gt;     Dato booleano o indicador (Sí / No) que valida si el usuario está en la&lt;br&gt;     base de datos.&lt;/span&gt;&lt;/li&gt;&lt;br&gt; &lt;li class=&quot;MsoNormal&quot;&gt;&lt;b&gt;&lt;span style=&quot;font-size:8.0pt;line-height:107%;font-family:&amp;quot;Arial&amp;quot;,sans-serif&quot;&gt;Espacios&lt;br&gt;     Disponibles:&lt;/span&gt;&lt;/b&gt;&lt;span style=&quot;font-size:8.0pt;line-height:107%;&amp;lt;br/&amp;gt;     font-family:&amp;quot;Arial&amp;quot;,sans-serif&quot;&gt; Valor numérico entero que representa la&lt;br&gt;     cantidad de cajones libres en ese momento.&lt;/span&gt;&lt;/li&gt;&lt;br&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="260" width="240" y="180" as="geometry" />
        </mxCell>
        <mxCell id="0Tio4Mt13xS4k5-K0IEx-47" parent="0Tio4Mt13xS4k5-K0IEx-44" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="&lt;p class=&quot;MsoNormal&quot;&gt;&lt;b&gt;&lt;span style=&quot;font-size:8.0pt;line-height:107%;font-family:&amp;lt;br/&amp;gt;&amp;quot;Arial&amp;quot;,sans-serif&quot;&gt;3. Identificación de los Procesos&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;ul style=&quot;margin-top:0cm&quot; type=&quot;disc&quot;&gt; &lt;li class=&quot;MsoNormal&quot;&gt;&lt;b&gt;&lt;span style=&quot;font-size:8.0pt;line-height:107%;font-family:&amp;quot;Arial&amp;quot;,sans-serif&quot;&gt;Consulta&lt;br&gt;     de registro:&lt;/span&gt;&lt;/b&gt;&lt;span style=&quot;font-size:8.0pt;line-height:107%;&amp;lt;br/&amp;gt;     font-family:&amp;quot;Arial&amp;quot;,sans-serif&quot;&gt; Comparación de la matrícula ingresada con&lt;br&gt;     la base de datos.&lt;/span&gt;&lt;/li&gt;&lt;br&gt; &lt;li class=&quot;MsoNormal&quot;&gt;&lt;b&gt;&lt;span style=&quot;font-size:8.0pt;line-height:107%;font-family:&amp;quot;Arial&amp;quot;,sans-serif&quot;&gt;Evaluación&lt;br&gt;     de cupo:&lt;/span&gt;&lt;/b&gt;&lt;span style=&quot;font-size:8.0pt;line-height:107%;&amp;lt;br/&amp;gt;     font-family:&amp;quot;Arial&amp;quot;,sans-serif&quot;&gt; Comprobación matemática de si los&lt;br&gt;     espacios libres son mayores a cero (Espacios Disponibles &amp;gt; 0).&lt;/span&gt;&lt;/li&gt;&lt;br&gt; &lt;li class=&quot;MsoNormal&quot;&gt;&lt;b&gt;&lt;span style=&quot;font-size:8.0pt;line-height:107%;font-family:&amp;quot;Arial&amp;quot;,sans-serif&quot;&gt;Actualización&lt;br&gt;     de inventario:&lt;/span&gt;&lt;/b&gt;&lt;span style=&quot;font-size:8.0pt;line-height:107%;&amp;lt;br/&amp;gt;     font-family:&amp;quot;Arial&amp;quot;,sans-serif&quot;&gt; Cálculo aritmético para descontar el&lt;br&gt;     lugar ocupado cuando el acceso es autorizado:&lt;/span&gt;&lt;/li&gt;&lt;br&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="280" width="240" y="440" as="geometry" />
        </mxCell>
        <mxCell id="0Tio4Mt13xS4k5-K0IEx-53" parent="1" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=0;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="880" width="240" x="-170" y="20" as="geometry" />
        </mxCell>
        <mxCell id="0Tio4Mt13xS4k5-K0IEx-54" parent="1" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="&lt;p class=&quot;MsoNormal&quot;&gt;&lt;b&gt;&lt;span style=&quot;font-size:8.0pt;line-height:107%;font-family:&amp;lt;br/&amp;gt;&amp;quot;Arial&amp;quot;,sans-serif&quot;&gt;4. Identificación de las Decisiones&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;p class=&quot;MsoNormal&quot;&gt;&lt;span style=&quot;font-size:8.0pt;line-height:107%;font-family:&amp;lt;br/&amp;gt;&amp;quot;Arial&amp;quot;,sans-serif&quot;&gt;Son los puntos de bifurcación donde el algoritmo toma un&lt;br&gt;camino según se cumpla o no una condición:&lt;/span&gt;&lt;/p&gt;&lt;ul style=&quot;margin-top:0cm&quot; type=&quot;disc&quot;&gt; &lt;li class=&quot;MsoNormal&quot;&gt;&lt;b&gt;&lt;span style=&quot;font-size:8.0pt;line-height:107%;font-family:&amp;quot;Arial&amp;quot;,sans-serif&quot;&gt;Primera&lt;br&gt;     decisión (¿Persona registrada?):&lt;/span&gt;&lt;/b&gt;&lt;/li&gt;&lt;ul style=&quot;margin-top:0cm&quot; type=&quot;circle&quot;&gt;  &lt;li class=&quot;MsoNormal&quot;&gt;&lt;b&gt;&lt;span style=&quot;font-size:8.0pt;line-height:107%;font-family:&amp;quot;Arial&amp;quot;,sans-serif&quot;&gt;No:&lt;/span&gt;&lt;/b&gt;&lt;span style=&quot;font-size:8.0pt;line-height:107%;font-family:&amp;quot;Arial&amp;quot;,sans-serif&quot;&gt;&lt;br&gt;      El sistema desvía el flujo hacia el mensaje de error por falta de&lt;br&gt;      registro y finaliza el proceso.&lt;/span&gt;&lt;/li&gt;  &lt;li class=&quot;MsoNormal&quot;&gt;&lt;b&gt;&lt;span style=&quot;font-size:8.0pt;line-height:107%;font-family:&amp;quot;Arial&amp;quot;,sans-serif&quot;&gt;Sí:&lt;/span&gt;&lt;/b&gt;&lt;span style=&quot;font-size:8.0pt;line-height:107%;font-family:&amp;quot;Arial&amp;quot;,sans-serif&quot;&gt;&lt;br&gt;      El sistema permite avanzar a la siguiente comprobación.&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt; &lt;li class=&quot;MsoNormal&quot;&gt;&lt;b&gt;&lt;span style=&quot;font-size:8.0pt;line-height:107%;font-family:&amp;quot;Arial&amp;quot;,sans-serif&quot;&gt;Segunda&lt;br&gt;     decisión (¿Lugares disponibles?):&lt;/span&gt;&lt;/b&gt;&lt;/li&gt;&lt;ul style=&quot;margin-top:0cm&quot; type=&quot;circle&quot;&gt;  &lt;li class=&quot;MsoNormal&quot;&gt;&lt;b&gt;&lt;span style=&quot;font-size:8.0pt;line-height:107%;font-family:&amp;quot;Arial&amp;quot;,sans-serif&quot;&gt;No:&lt;/span&gt;&lt;/b&gt;&lt;span style=&quot;font-size:8.0pt;line-height:107%;font-family:&amp;quot;Arial&amp;quot;,sans-serif&quot;&gt; El&lt;br&gt;      sistema desvía el flujo hacia el mensaje de error por estacionamiento&lt;br&gt;      lleno y finaliza el proceso.&lt;/span&gt;&lt;/li&gt;  &lt;li class=&quot;MsoNormal&quot;&gt;&lt;b&gt;&lt;span style=&quot;font-size:8.0pt;line-height:107%;font-family:&amp;quot;Arial&amp;quot;,sans-serif&quot;&gt;Sí:&lt;/span&gt;&lt;/b&gt;&lt;span style=&quot;font-size:8.0pt;line-height:107%;font-family:&amp;quot;Arial&amp;quot;,sans-serif&quot;&gt;&lt;br&gt;      El sistema autoriza la operación de resta y permite el paso.&lt;/span&gt;&lt;/li&gt;&lt;br&gt; &lt;/ul&gt;&lt;br&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="390" width="240" x="-170" y="20" as="geometry" />
        </mxCell>
        <mxCell id="0Tio4Mt13xS4k5-K0IEx-55" parent="1" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="&lt;p class=&quot;MsoNormal&quot;&gt;&lt;b&gt;&lt;span style=&quot;font-size:8.0pt;line-height:107%;font-family:&amp;lt;br/&amp;gt;&amp;quot;Arial&amp;quot;,sans-serif&quot;&gt;5. Identificación de las Salidas&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;p class=&quot;MsoNormal&quot;&gt;&lt;span style=&quot;font-size:8.0pt;line-height:107%;font-family:&amp;lt;br/&amp;gt;&amp;quot;Arial&amp;quot;,sans-serif&quot;&gt;Son las respuestas o resultados visuales que el sistema devuelve&lt;br&gt;al usuario o pantalla:&lt;/span&gt;&lt;/p&gt;&lt;ul style=&quot;margin-top:0cm&quot; type=&quot;disc&quot;&gt; &lt;li class=&quot;MsoNormal&quot;&gt;&lt;b&gt;&lt;span style=&quot;font-size:8.0pt;line-height:107%;font-family:&amp;quot;Arial&amp;quot;,sans-serif&quot;&gt;Salida&lt;br&gt;     1 (Denegación por registro):&lt;/span&gt;&lt;/b&gt;&lt;span style=&quot;font-size:8.0pt;&amp;lt;br/&amp;gt;     line-height:107%;font-family:&amp;quot;Arial&amp;quot;,sans-serif&quot;&gt; Muestra el mensaje &quot;Acceso&lt;br&gt;     denegado: Usuario no registrado&quot;.&lt;/span&gt;&lt;/li&gt; &lt;li class=&quot;MsoNormal&quot;&gt;&lt;b&gt;&lt;span style=&quot;font-size:8.0pt;line-height:107%;font-family:&amp;quot;Arial&amp;quot;,sans-serif&quot;&gt;Salida&lt;br&gt;     2 (Denegación por cupo):&lt;/span&gt;&lt;/b&gt;&lt;span style=&quot;font-size:8.0pt;&amp;lt;br/&amp;gt;     line-height:107%;font-family:&amp;quot;Arial&amp;quot;,sans-serif&quot;&gt; Muestra el mensaje &quot;Acceso&lt;br&gt;     denegado: Estacionamiento lleno&quot;.&lt;/span&gt;&lt;/li&gt; &lt;li class=&quot;MsoNormal&quot;&gt;&lt;b&gt;&lt;span style=&quot;font-size:8.0pt;line-height:107%;font-family:&amp;quot;Arial&amp;quot;,sans-serif&quot;&gt;Salida&lt;br&gt;     3 (Acceso concedido):&lt;/span&gt;&lt;/b&gt;&lt;span style=&quot;font-size:8.0pt;line-height:&amp;lt;br/&amp;gt;     107%;font-family:&amp;quot;Arial&amp;quot;,sans-serif&quot;&gt; Muestra el mensaje &quot;Acceso&lt;br&gt;     permitido: Bienvenido&quot; junto con la confirmación de la reducción del&lt;br&gt;     cupo.&lt;/span&gt;&lt;/li&gt;&lt;br&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="300" width="240" x="-170" y="410" as="geometry" />
        </mxCell>
        <mxCell id="0Tio4Mt13xS4k5-K0IEx-56" parent="1" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="&lt;p class=&quot;MsoNormal&quot;&gt;&lt;b&gt;&lt;span style=&quot;font-size:8.0pt;line-height:107%;font-family:&amp;lt;br/&amp;gt;&amp;quot;Arial&amp;quot;,sans-serif&quot;&gt;6. Construcción del Algoritmo&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;p class=&quot;MsoNormal&quot;&gt;&lt;span style=&quot;font-size:8.0pt;line-height:107%;font-family:&amp;lt;br/&amp;gt;&amp;quot;Arial&amp;quot;,sans-serif&quot;&gt;Consiste en la integración secuencial de los puntos&lt;br&gt;anteriores reflejada en el diagrama de flujo: se inicia con la lectura de las&lt;br&gt;entradas, pasa por el primer rombo de decisión (registro), si se aprueba pasa&lt;br&gt;al segundo rombo (disponibilidad), realiza el proceso de decremento del espacio&lt;br&gt;y concluye mostrando la salida correspondiente en el bloque final.&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="230" width="240" x="-170" y="690" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
